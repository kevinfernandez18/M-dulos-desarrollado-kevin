<odoo>
    <record id="view_executive_dashboard_form" model="ir.ui.view">
        <field name="name">executive.dashboard.form</field>
        <field name="model">executive.dashboard</field>
        <field name="arch" type="xml">
            <form string="Executive Dashboard" create="1" edit="1">
                <header>
                    <button name="action_refresh" string="Actualizar" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="period_type"/>
                            <field name="date_from" attrs="{'readonly': [('period_type', '!=', 'custom')]}"/>
                            <field name="date_to" attrs="{'readonly': [('period_type', '!=', 'custom')]}"/>
                        </group>
                    </group>

                    <group string="KPIs Principales" col="4">
                        <group string="Ventas / Facturación">
                            <field name="sales_amount" readonly="1"/>
                            <field name="sales_count" readonly="1"/>
                            <field name="avg_ticket" readonly="1"/>
                            <field name="sales_amount_prev" readonly="1"/>
                        </group>
                        <group string="Cuentas por cobrar (CXC)">
                            <field name="ar_pending" readonly="1"/>
                            <field name="ar_overdue" readonly="1"/>
                            <field name="ar_due" readonly="1"/>
                        </group>
                        <group string="Cuentas por pagar (CXP)">
                            <field name="ap_pending" readonly="1"/>
                            <field name="ap_overdue" readonly="1"/>
                            <field name="ap_due" readonly="1"/>
                        </group>
                        <group string="Caja y Bancos">
                            <field name="cash_bank_balance" readonly="1"/>
                        </group>
                    </group>

                    <group string="Pérdidas y Ganancias (Contable)" col="5">
                        <field name="income_amount" readonly="1"/>
                        <field name="cogs_amount" readonly="1"/>
                        <field name="expense_amount" readonly="1"/>
                        <field name="gross_profit" readonly="1"/>
                        <field name="net_profit" readonly="1"/>
                        <field name="net_profit_prev" readonly="1"/>
                    </group>

                    <group string="Qué me preocupa" col="3">
                        <field name="overdue_ar_count" readonly="1"/>
                        <field name="overdue_ap_count" readonly="1"/>
                        <field name="show_stock_alert" invisible="1"/>
                        <field name="critical_stock_count" readonly="1" attrs="{'invisible': [('show_stock_alert', '=', False)]}"/>
                    </group>

                    <group string="Acciones rápidas" col="3">
                        <button name="action_view_overdue_receivables" type="object" string="Ver cobranza vencida" class="btn-secondary"/>
                        <button name="action_view_overdue_payables" type="object" string="Ver pagos vencidos" class="btn-secondary"/>
                        <button name="action_view_payments" type="object" string="Registrar pago / Ir a pagos" class="btn-secondary"/>
                        <button name="action_view_sales_period" type="object" string="Ver facturación del período" class="btn-secondary"/>
                        <button name="action_view_pnl_detail" type="object" string="Ver P&amp;L detallado" class="btn-secondary"/>
                        <button name="action_view_products_no_sales" type="object" string="Ver productos sin ventas" class="btn-secondary"/>
                        <button name="action_view_top_products" type="object" string="Top productos del período" class="btn-secondary"/>
                        <button name="action_view_bottom_products" type="object" string="Bottom productos del período" class="btn-secondary"/>
                    </group>

                    <group string="Productos más y menos vendidos" col="2">
                        <field name="top_products_html" nolabel="1" widget="html" readonly="1"/>
                        <field name="bottom_products_html" nolabel="1" widget="html" readonly="1"/>
                    </group>

                    <group string="Gráficos ejecutivos" col="2">
                        <field name="chart_sales_daily_html" nolabel="1" widget="html" readonly="1"/>
                        <field name="chart_net_daily_html" nolabel="1" widget="html" readonly="1"/>
                        <field name="chart_income_expense_monthly_html" nolabel="1" widget="html" readonly="1"/>
                        <field name="chart_ar_aging_html" nolabel="1" widget="html" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_executive_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">executive.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_executive_dashboard_form"/>
        <field name="target">current</field>
        <field name="context">{'default_period_type': 'today'}</field>
        <field name="groups_id" eval="[(4, ref('executive_dashboard.group_ceo'))]"/>
    </record>

    <menuitem id="menu_executive_root" name="Gerencia" sequence="10" groups="executive_dashboard.group_ceo"/>
    <menuitem id="menu_executive_dashboard" name="Dashboard" parent="menu_executive_root" action="action_executive_dashboard" sequence="10" groups="executive_dashboard.group_ceo"/>
</odoo>
